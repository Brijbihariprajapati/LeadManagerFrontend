# Local: proxy /api to Express (see vite.config.js). Same as old NEXT_PUBLIC_USE_API_PROXY.
VITE_USE_API_PROXY=1

# Optional: override proxy target (default http://localhost:5000)
# VITE_DEV_API_PROXY=http://localhost:5000

# --- Vercel / production ---
# Build-time: set in Vercel → Project → Settings → Environment Variables (no trailing slash).
# Do NOT set VITE_USE_API_PROXY=1 there (no dev proxy in production).
# VITE_API_URL=https://your-backend.vercel.app

# Production: full API origin when not using same-origin /api (omit VITE_USE_API_PROXY or set 0)
# VITE_API_URL=https://your-api.example.com
